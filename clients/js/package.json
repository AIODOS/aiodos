{
  "name": "aiodos-client",
  "version": "0.2.0",
  "description": "Client JavaScript d'AIODOS pour les applications (Node, processus principal d'Electron) : découverte, accès par appli, catalogue, conversation en flux, embeddings, travaux ComfyUI (entrées, suivi en direct, fichiers repris et vérifiés). Sans dépendance.",
  "keywords": [
    "aiodos",
    "llm",
    "local",
    "openai",
    "client",
    "electron",
    "comfyui"
  ],
  "homepage": "https://github.com/AIODOS/aiodos/tree/main/clients/js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AIODOS/aiodos.git",
    "directory": "clients/js"
  },
  "license": "Apache-2.0",
  "author": "22eme Arkane",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./fake": {
      "types": "./fake.d.ts",
      "default": "./src/fake.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "contract/",
    "index.d.ts",
    "fake.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "sideEffects": [
    "./src/guard.js",
    "./src/index.js"
  ],
  "scripts": {
    "test": "node --test",
    "sync-contract": "node scripts/sync-contract.mjs"
  }
}
